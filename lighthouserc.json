{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse-ci/main/docs/recipes/lighthouserc-schema.json",
  "ci": {
    "collect": {
      "url": ["http://localhost:8787/", "http://localhost:8787/place/p018"],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance"],
        "skipAudits": ["uses-http2", "is-on-https", "redirects-http"]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 10000, "aggregationMethod": "median" }],
        "categories:performance": ["warn", { "minScore": 0.5, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
