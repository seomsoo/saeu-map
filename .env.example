NEXT_PUBLIC_NCP_CLIENT_ID=
# 서버 전용(선택): metadataBase·sitemap·robots의 절대 URL. 비우면 https://saeu-map.saeu-map.workers.dev
SITE_URL=
# 선택: GA4 측정 ID (G-XXXXXXX). 비우면 스크립트를 안 붙인다 — dev·프리뷰 수치가 섞이지 않게.
# 붙이기 전에 개인정보처리방침·동의 배너를 먼저 정한다 (roadmap Phase 7)
NEXT_PUBLIC_GA_ID=

# ── Phase 6 백엔드 (docs/plans/phase6-backend.md · docs/runbook.md) ──────────────
# Supabase — 셋 다 서버 전용. 브라우저에 supabase-js가 없어 publishable도 NEXT_PUBLIC_ 아님(규칙 7).
# 로컬은 `supabase start`가 찍어 주는 값(http://127.0.0.1:54321 + 로컬 키), 실서비스는 대시보드 API Keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# secret key(sb_secret_…)는 RLS를 무시한다 — 병합·탈퇴·임포트·크론만 쓴다. 프리뷰 워커에는 주지 않는다.
SUPABASE_SECRET_KEY=
# Turnstile(사람 확인). site key는 공개값(위젯을 그리려면 브라우저가 안다), secret은 서버 검증용.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 디스코드 채널 웹훅 — 제보·신고·사장님 요청·신고 3회째 알림. URL 자체가 비밀이다(아무나 채널에 글을 쓴다).
DISCORD_WEBHOOK_URL=
# IP 해시 salt(속도 제한용, sha256(IP + salt + KST 날짜)). 아무 긴 문자열. 새면 교체만 하면 된다.
IP_HASH_SALT=
# 프리뷰 워커만 1 — 모든 쓰기·로그인·익명 생성을 "프리뷰는 읽기 전용이에요"로 거부 (decisions 2026-09-10)
PREVIEW_READONLY=
# Sentry DSN(공개값, 브라우저 에러를 보낼 주소). 비우면 Sentry를 붙이지 않는다.
NEXT_PUBLIC_SENTRY_DSN=
